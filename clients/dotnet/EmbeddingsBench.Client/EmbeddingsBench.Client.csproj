<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EmbeddingsBench.Client</PackageId>
    <Version>1.0.0</Version>
    <Authors>Samuel Gorzalnik</Authors>
    <Description>Client for the EmbeddingsBench inference API: text classification with registry models (label, confidence, top-k, distribution) and jina v5 embeddings.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/gorzalniksamuel/EmbeddingsBench</RepositoryUrl>
    <PackageTags>text-classification;embeddings;jina;inference</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

</Project>
