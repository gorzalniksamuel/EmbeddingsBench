# Copy to .env and adjust. Every entry point (bench/*.py, bench/*.sh, web/*.py) reads this file.

# Working directory for data/, embeddings/, results/, models/ and registry/ (default: repository root)
EB_ROOT=
# Python interpreter of the virtual environment (used by the shell scripts and the job worker)
EB_PYTHON=.venv/bin/python
# Hugging Face cache for model weights and datasets
HF_HOME=

# ---- GPU (bench/gpu.py) ------------------------------------------------------------------------------
# GPU index to use (default: the one with the most free memory); no GPU = CPU
EB_GPU=
# Force a precision: bf16 | fp16 | fp32 (default: bf16 on Ampere+, fp16 on older GPUs, fp32 on CPU)
EB_DTYPE=
# Shared GPU: wait until this much memory is free before loading the encoder / gbert
EB_MIN_FREE_VRAM_GB=4.0
EB_GBERT_MIN_FREE_VRAM_GB=7.0
# Padded tokens per embedding batch per free GiB (lower it if embedding runs out of memory)
EB_TOKENS_PER_GB=4000

# ---- GPU server elsewhere ----------------------------------------------------------------------------
# Remote embeddings: URL of web/inference.py (or any OpenAI-compatible /v1/embeddings with the same model)
EB_EMBED_URL=
# Remote jobs over SSH (bench/remote.py); the job worker uses it for every job when set
EB_REMOTE_HOST=
EB_REMOTE_DIR=EmbeddingsBench
EB_REMOTE_PYTHON=.venv/bin/python
EB_SSH_OPTS=

# ---- Dashboard + registry API (web/app.py): no authentication, bind to localhost or a private network --
EB_BIND=127.0.0.1
EB_PORT=8095
EB_SITE_DIR=site
EB_CODE_DIR=bench

# ---- Inference service (web/inference.py) -------------------------------------------------------------
EB_INFER_BIND=127.0.0.1
EB_INFER_PORT=8096
# Bearer token required by the inference service (and sent by remote-embedding clients); empty = no auth
EB_API_KEY=

# ---- run_benchmark.sh ---------------------------------------------------------------------------------
# Datasets to fine-tune (space separated, empty = none), epochs, MLP search trials
EB_FINETUNE="20_newsgroups yahoo_answers arxiv_11 gnad10 amazon_reviews_de massive_intent_de"
EB_FT_EPOCHS=3
# German-native reference (gbert-large, ~7 GiB GPU) and datasets for the imbalance schemes
EB_GBERT="gnad10 amazon_reviews_de massive_intent_de"
EB_IMBALANCED="ledgar mtop_intent_de swiss_caselaw_de off_de hupd_ipc"
EB_MLP_TRIALS=40
